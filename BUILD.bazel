load("//build:checks.bzl", "host_test")
load("//packages:package.bzl", "package_store")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
    "Cargo.lock",
])

alias(
    name = "gcsl",
    actual = "//crates/gcsl-cli:gcsl",
)

filegroup(
    name = "artifacts",
    srcs = [":gcsl"],
)

filegroup(
    name = "standard-library",
    srcs = glob(["stdlib/**"]),
)

filegroup(
    name = "rust-sources",
    srcs = [
        "//crates/gcsl:sources",
        "//crates/gcsl-cli:sources",
        "//crates/gcsl-disk:sources",
        "//crates/gcsl-lsp:sources",
    ],
)

filegroup(
    name = "test-fixtures",
    srcs = [
        ":standard-library",
        "//crates/gcsl:fixtures",
        "//crates/gcsl-cli:fixtures",
        "//crates/gcsl-disk:fixtures",
        "//crates/gcsl-lsp:fixtures",
    ],
)

filegroup(
    name = "build-files",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "//build:BUILD.bazel",
        "//build:starlark",
        "//crates/gcsl:BUILD.bazel",
        "//crates/gcsl-cli:BUILD.bazel",
        "//crates/gcsl-disk:BUILD.bazel",
        "//crates/gcsl-lsp:BUILD.bazel",
        "//packages:build-files",
        "//tools:BUILD.bazel",
        "//vendor/ppk:BUILD.bazel",
    ],
)

genrule(
    name = "build-format-check",
    srcs = [":build-files"],
    outs = ["build-format-check.stamp"],
    cmd = "$(execpath @buildifier//file) -mode=check -lint=warn $(execpaths :build-files) && touch $@",
    tools = ["@buildifier//file"],
)

host_test(
    name = "vendor-test",
    size = "small",
    command = "exec python3 tools/test-bazel-vendor.py",
    data = [
        "//tools:bazel-vendor.py",
        "//tools:test-bazel-vendor.py",
    ],
    tags = [
        "external",
        "no-remote",
    ],
)

filegroup(
    name = "package-data",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        "//crates/gcsl:Cargo.toml",
        "//crates/gcsl-cli:Cargo.toml",
        "//crates/gcsl-disk:Cargo.toml",
        "//crates/gcsl-lsp:Cargo.toml",
        "//packages:definitions",
    ] + glob(
        ["docs/man/*"],
        allow_empty = True,
    ),
)

filegroup(
    name = "package-sources",
    srcs = glob(
        ["**"],
        exclude = [
            "**/.*/**",
            "**/.*",
            ".git/**",
            "bazel-*/**",
            "bazel-*",
            "target/**",
            "**/__pycache__/**",
            "**/*.pyc",
            "docs/learn/dist/**",
            "docs/specs/**",
            "docs/DECISIONS.md",
            "docs/INFERENCE_REQS.md",
        ],
    ) + glob(
        [".github/**"],
        allow_empty = True,
    ) + [
        ".bazelignore",
        ".bazelrc",
        ".bazelversion",
        ".gitattributes",
        ".gitignore",
        ":package-data",
        ":rust-sources",
        "//build:sources",
        "//crates/gcsl:BUILD.bazel",
        "//crates/gcsl-cli:BUILD.bazel",
        "//crates/gcsl-disk:BUILD.bazel",
        "//crates/gcsl-lsp:BUILD.bazel",
        "//packages:sources",
        "//tools:sources",
        "//vendor/ppk:sources",
    ],
)

package_store(
    name = "packages",
    packages = ["//packages:all"],
)
