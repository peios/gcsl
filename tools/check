#!/bin/sh
# Bazel builds and tests the programs; Cargo adds lint and rustdoc diagnostics,
# and runs every test again, unoptimised, as STACK_SIZE's depth tests assume:
# Bazel's build has smaller stack frames, so it can pass a test Cargo's fails.
set -eu
repo=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo"
python3 tools/style-check.py
./bazel build //:build-format-check
./bazel test //...
cargo +1.98.1 clippy --workspace --all-targets --locked -- -D warnings
cargo +1.98.1 test --workspace --locked
# Every GCSL test again with plain runs on the machine, as graph mode runs.
cargo +1.98.1 clippy -p gcsl --all-targets --locked --features machine-everywhere -- -D warnings
cargo +1.98.1 test -p gcsl --locked --features machine-everywhere
