#!/bin/sh
# The gate: style, strict lints, and every test, then every GCSL test again
# with plain runs on the machine, as graph mode runs. Cargo's unoptimised
# tests are the ones STACK_SIZE's depth tests assume.
set -eu
repo=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo"
python3 tools/style-check.py
cargo +1.98.1 clippy --workspace --all-targets --locked -- -D warnings
cargo +1.98.1 test --workspace --locked
cargo +1.98.1 clippy -p gcsl --all-targets --locked --features machine-everywhere -- -D warnings
cargo +1.98.1 test -p gcsl --locked --features machine-everywhere
