load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "fixtures",
    srcs = glob(
        ["tests/fixtures/**"],
        allow_empty = True,
    ),
)

rust_binary(
    name = "gcsl",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//:standard-library"],
    crate_name = "gcsl",
    crate_root = "src/main.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = VERSION,
    deps = all_crate_deps(normal = True) + [
        "//crates/gcsl",
        "//crates/gcsl-disk",
        "//crates/gcsl-lsp",
    ],
)

rust_test(
    name = "tests",
    size = "large",
    crate = ":gcsl",
)

rust_test(
    name = "cli-test",
    size = "large",
    srcs = glob(["tests/cli/*.rs"]),
    crate_root = "tests/cli/main.rs",
    data = [
        ":gcsl",
        "//:test-fixtures",
    ],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "./crates/gcsl-cli",
        "CARGO_BIN_EXE_gcsl": "$(rootpath :gcsl)",
    },
    version = VERSION,
    deps = all_crate_deps(normal = True) + [
        "//crates/gcsl",
        "//crates/gcsl-disk",
        "//crates/gcsl-lsp",
    ],
)
