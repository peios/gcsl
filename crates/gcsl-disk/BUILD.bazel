load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "fixtures",
    srcs = glob(
        ["tests/fixtures/**"],
        allow_empty = True,
    ),
)

rust_library(
    name = "gcsl-disk",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//:standard-library"],
    crate_name = "gcsl_disk",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = VERSION,
    deps = all_crate_deps(normal = True) + ["//crates/gcsl"],
)

rust_test(
    name = "tests",
    size = "large",
    crate = ":gcsl-disk",
)

rust_test(
    name = "format-test",
    size = "large",
    srcs = ["tests/format.rs"],
    data = ["//:test-fixtures"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "./crates/gcsl-disk",
    },
    version = VERSION,
    deps = all_crate_deps(normal = True) + ["//crates/gcsl"] + [":gcsl-disk"],
)

rust_test(
    name = "recovery-test",
    size = "large",
    srcs = ["tests/recovery.rs"],
    data = ["//:test-fixtures"],
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "./crates/gcsl-disk",
    },
    version = VERSION,
    deps = all_crate_deps(normal = True) + ["//crates/gcsl"] + [":gcsl-disk"],
)

rust_doc_test(
    name = "doc-tests",
    crate = ":gcsl-disk",
)
