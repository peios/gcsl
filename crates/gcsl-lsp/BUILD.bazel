load("@crates//:crates.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")
load("//build:version.bzl", "VERSION")

package(default_visibility = ["//visibility:public"])

exports_files([
    "BUILD.bazel",
    "Cargo.toml",
])

filegroup(
    name = "sources",
    srcs = glob(
        [
            "src/**",
            "tests/**",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "fixtures",
    srcs = glob(
        ["tests/fixtures/**"],
        allow_empty = True,
    ),
)

rust_library(
    name = "gcsl-lsp",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//:standard-library"],
    crate_name = "gcsl_lsp",
    crate_root = "src/lib.rs",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = VERSION,
    deps = all_crate_deps(normal = True) + [
        "//crates/gcsl",
        "//crates/gcsl-disk",
    ],
)

rust_test(
    name = "tests",
    size = "large",
    crate = ":gcsl-lsp",
)

rust_doc_test(
    name = "doc-tests",
    crate = ":gcsl-lsp",
)
